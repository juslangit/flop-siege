#!/usr/bin/env bash
# Put the portfolio live on Cloudflare Pages: https://luqmanhakeem.pages.dev
#
#   ./tools/deploy.sh
#
# Uses the Cloudflare login already stored by wrangler (`npx wrangler login`
# if it ever expires). The records are uploaded too, but functions/ locks them:
# Cloudflare only serves /records/ to someone signed in. The sign-in details are
# Cloudflare secrets (RECORDS_USER, RECORDS_PASSWORD, SESSION_SECRET), never files.
set -euo pipefail

PROJECT="luqmanhakeem"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export CLOUDFLARE_ACCOUNT_ID="863c8569b09cb26bbcb75f90f23a26e5"

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT

cd "$ROOT"
rsync -a --exclude '.*' --exclude 'functions' --exclude 'tools' --exclude 'docs' \
      --exclude 'behance-cards' --exclude 'README.md' --exclude 'node_modules' \
      ./ "$STAGE/"

echo "Uploading $(du -sh "$STAGE" | cut -f1)…"
# Run from the repo root: wrangler picks up ./functions from the working directory.
npx --yes wrangler@latest pages deploy "$STAGE" \
  --project-name "$PROJECT" --branch main --commit-dirty=true
