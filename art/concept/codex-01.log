+<!-- ============ RECORDS SIGN-IN ============ -->
+<div class="signin" id="signin" role="dialog" aria-modal="true" aria-labelledby="signin-title">
+  <form class="signin-box" id="signin-form" autocomplete="on">
+    <button type="button" class="signin-close" id="signin-close" aria-label="Close">&times;</button>
+    <h2 id="signin-title">Private records</h2>
+    <p>The project records are private. Sign in to read them.</p>
+    <label for="signin-user">Username</label>
+    <input id="signin-user" name="username" autocomplete="username" autocapitalize="off" spellcheck="false" required>
+    <label for="signin-pass">Password</label>
+    <input id="signin-pass" name="password" type="password" autocomplete="current-password" required>
+    <button type="submit" id="signin-go">Sign in</button>
+    <p class="signin-err" id="signin-err" role="alert"></p>
+  </form>
+</div>
+<script>
+/* Records sign-in. The real lock is on the server (functions/records/_middleware.js):
+   without a session Cloudflare never sends a record. This only decides whether
+   to open the box before following a record link. */
+(function(){
+  var box = document.getElementById("signin"), form = document.getElementById("signin-form"),
+      user = document.getElementById("signin-user"), pass = document.getElementById("signin-pass"),
+      go = document.getElementById("signin-go"), err = document.getElementById("signin-err"),
+      target = null;
+  if (location.protocol === "file:") return;   // opened from disk: no server, no lock
+
+  function open(href){
+    target = href; err.textContent = ""; box.classList.add("open");
+    setTimeout(function(){ user.focus(); }, 30);
+  }
+  function close(){ box.classList.remove("open"); target = null; }
+
+  document.addEventListener("click", function(e){
+    var a = e.target.closest && e.target.closest('a[href^="records/"], a[href^="/records/"]');
+    if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
+    e.preventDefault();
+    var href = a.href;
+    fetch("/api/session", {credentials: "same-origin"}).then(function(r){ return r.json(); })
+      .then(function(s){ s.signedIn ? location.href = href : open(href); })
+      .catch(function(){ open(href); });
+  });
+
+  form.addEventListener("submit", function(e){
+    e.preventDefault(); go.disabled = true; err.textContent = "";
+    fetch("/api/login", {method: "POST", credentials: "same-origin",
+      headers: {"Content-Type": "application/json"},
+      body: JSON.stringify({username: user.value.trim(), password: pass.value})})
+    .then(function(r){
+      if (r.ok){ location.href = target || "/records/"; return; }
+      err.textContent = "That username or password is not right.";
+      pass.value = ""; pass.focus();
+      form.classList.remove("shake"); void form.offsetWidth; form.classList.add("shake");
+    })
+    .catch(function(){ err.textContent = "Could not reach the server. Try again."; })
+    .then(function(){ go.disabled = false; });
+  });
+
+  document.getElementById("signin-close").addEventListener("click", close);
+  box.addEventListener("click", function(e){ if (e.target === box) close(); });
+  document.addEventListener("keydown", function(e){ if (e.key === "Escape" && box.classList.contains("open")) close(); });
+
+  // Sent back here by the server after opening a record link directly.
+  var want = new URLSearchParams(location.search).get("signin");
+  if (want && want.indexOf("/records") === 0){
+    history.replaceState(null, "", location.pathname + location.hash);
+    open(want);
+  }
+})();
+</script>
 </body>
